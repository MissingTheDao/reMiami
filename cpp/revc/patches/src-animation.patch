+
+// revc: the imported PS2 file for this cut's animation or camera path ("ifp"/"dat"), in the PS2 UI style
+static bool
+CutscenePs2File(const char *cut, const char *ext, char *out, size_t cap)
+{
+#ifdef LIBRW_HOST
+	if (gUiStyle != 1)
+		return false;
+	char rel[64];
+	snprintf(rel, sizeof(rel), "cuts/%s.%s", cut, ext);
+	for (char *c = rel; *c; c++)
+		*c = tolower(*c);
+	return revc_import_path(1, rel, out, cap) > 0;
+#else
+	return false;
+#endif
+}
