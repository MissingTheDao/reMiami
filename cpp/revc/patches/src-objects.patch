+extern "C" int32
+revc_cpp_find_model(const char *name, size_t len)
+{
+	char buf[256];
+	if(len >= sizeof(buf))
+		len = sizeof(buf) - 1;
+	memcpy(buf, name, len);
+	buf[len] = '\0';
+	int id = -1;
+	if(CModelInfo::GetModelInfo(buf, &id) == nil){
+		debug("CObjectData: Cannot find object %s\n", buf);
+		return -1;
+	}
+	return id;
+}
+
+extern "C" void
+revc_cpp_set_object_id(int32 model, int16 id)
+{
+	CModelInfo::GetModelInfo(model)->SetObjectID(id);
