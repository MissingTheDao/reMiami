+		char rel[128], path[512];
+		for (size_t k = 0; k <= len; k++)
+			rel[k] = name[k] == '\\' ? '/' : tolower(name[k]);
+		if (revc_import_path(1, rel, path, sizeof(path)) <= 0)
+			continue;
+		FILE *f = fopen(path, "rb");
+		if (f == nil)
+			continue;
+		fseek(f, 0, SEEK_END);
+		long size = ftell(f);
+		fclose(f);
+		if (size <= 0)
+			continue;
+		// headerless PS-ADPCM, stereo: 28 samples per channel in every 16 bytes
+		uint64 frames = (uint64)size / 16 * 28 / 2;
+		nStreamLengthPs2[i] = (uint32)(frames * 1000 / (IsThisTrackAt16KHz(i) ? 16000 : 32000));
+	}
+}
+#endif
+
 int32
 cSampleManager::GetStreamedFileLength(uint8 nStream)
 {
 	ASSERT( nStream < TOTAL_STREAMED_SOUNDS );
 
+#ifdef LIBRW_HOST
+	if (gUiStyle == 1) {
+		if (!ps2LengthsDone)
+			MeasurePs2Streams();
+		if (nStreamLengthPs2[nStream] != 0)
+			return nStreamLengthPs2[nStream];
+	}
+#endif
 	return nStreamLength[nStream];
 }
 
