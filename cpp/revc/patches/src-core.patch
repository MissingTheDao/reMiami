+		PANEL_X(menuBg.topLeft_x), SCREEN_STRETCH_Y(menuBg.topLeft_y), 0.0f, 0.0f, CRGBA(0, 0, 0, 255));
+	CSprite2d::Draw2DPolygon(PANEL_X(menuBg.topRight_x), SCREEN_STRETCH_Y(menuBg.topRight_y),
+		PANEL_X(menuBg.topLeft_x), SCREEN_STRETCH_Y(menuBg.topLeft_y), SCREEN_WIDTH, 0.0f, 0.0f, 0.0f, CRGBA(0, 0, 0, 255));
+	CSprite2d::Draw2DPolygon(SCREEN_WIDTH, SCREEN_HEIGHT, 0.0f, SCREEN_HEIGHT, PANEL_X(menuBg.bottomRight_x), SCREEN_STRETCH_Y(menuBg.bottomRight_y),
+		PANEL_X(menuBg.bottomLeft_x), SCREEN_STRETCH_Y(menuBg.bottomLeft_y), CRGBA(0, 0, 0, 255));
+	CSprite2d::Draw2DPolygon(SCREEN_WIDTH, SCREEN_HEIGHT, PANEL_X(menuBg.bottomRight_x), SCREEN_STRETCH_Y(menuBg.bottomRight_y),
+		SCREEN_WIDTH, 0.0f, PANEL_X(menuBg.topRight_x), SCREEN_STRETCH_Y(menuBg.topRight_y), CRGBA(0, 0, 0, 255));
+}
+
+// revc: the menu's camo. The PS2 tiles its 128x128 texture once per 150 x 128 cell (640x448 units,
+// from the top left; PS2 v1.40, research: 25 quads); the Xbox draws it once over the 4:3 menu at
+// full alpha; the PC stretches it over the screen.
+void
+CMenuManager::DrawMenuBackground(const CRGBA &col)
+{
+	if (MenuSkinPS2Active(m_nCurrScreen, m_bGameNotLoaded)) {
+		CRGBA c = col;
+		float cw = MENU_X(150.0f), ch = MENU_Y(128.0f), x0 = MENU_X_LEFT_ALIGNED(0.0f);
+		while (x0 > 0.0f) x0 -= cw;
+		for (float y = 0.0f; y < SCREEN_HEIGHT; y += ch)
+			for (float x = x0; x < SCREEN_WIDTH; x += cw)
+				m_aFrontEndSprites[MENUSPRITE_BACKGROUND].Draw(CRect(x, y, x + cw, y + ch), c);
+		return;
+	}
+	if (MenuSkinXboxActive(m_nCurrScreen, m_bGameNotLoaded)) {	// the Xbox: one quad over the 4:3 menu, opaque
+		m_aFrontEndSprites[MENUSPRITE_BACKGROUND].Draw(CRect(MENU_X_LEFT_ALIGNED(0.0f), 0.0f, MENU_X_LEFT_ALIGNED(640.0f), SCREEN_HEIGHT),
+			CRGBA(col.r, col.g, col.b, 255));
+		return;
+	}
+	m_aFrontEndSprites[MENUSPRITE_BACKGROUND].Draw(CRect(0.0f, 0.0f, SCREEN_WIDTH, SCREEN_HEIGHT), col);
+}
