+void
+VisualStyleButtonPress(int8 action)
+{
+	if (action != FEOPTION_ACTION_LEFT && action != FEOPTION_ACTION_RIGHT && action != FEOPTION_ACTION_SELECT)
+		return;
+	const int n = ARRAY_SIZE(visualStyles);
+	int cur = CurrentVisualStyle();
+	int next;
+	if (action == FEOPTION_ACTION_LEFT)
+		next = cur < 0 ? n - 1 : (cur + n - 1) % n;
+	else
+		next = cur < 0 ? 0 : (cur + 1) % n;
+	for (int i = 0; i < n && !UiStyleAvailable(visualStyles[next].ui); i++)	// (skip the consoles without a disc)
+		next = action == FEOPTION_ACTION_LEFT ? (next + n - 1) % n : (next + 1) % n;
+	ApplyVisualStyle(next);
+	FrontEndMenuManager.SaveSettings();
+	MapStyleRestartNote();
+}
