+extern "C" int revc_pad_menu_nintendo(void);
+extern int8 gUiStyle;
+
+// revc: the Xbox version's flying controls and vehicle look (research on the Xbox build).
+// -1: PC rules (not the Xbox style, the "Original PC" layout, or keyboard and mouse);
+// 0: Xbox Standard (also the player's own bindings: the sticks aren't bindings); 1: Xbox Classic.
+extern "C" int PadLayoutCurrent(void);
+int
+XboxFlyLayout(void)
+{
+	if (gUiStyle != 2)
+		return -1;
+#ifdef LIBRW_HOST
+	extern bool gRevcTestPadOn;
+	if (!gRevcTestPadOn && hostActiveInputKind() == 0)
+		return -1;
+#endif
+	int layout = PadLayoutCurrent();
+	return layout == 1 ? 1 : layout == 2 ? -1 : 0;
+}
+
+// A stick axis as the Xbox's flying actions read it: the stick alone (no D-pad, no drunk buffer),
+// -128..128, y > 0 = pulled back. axis: 0 LX, 1 LY, 2 RX, 3 RY.
+int16
+XboxStick(int axis)
+{
+	CPad *pad = CPad::GetPad(0);
+	if (pad->ArePlayerControlsDisabled())
+		return 0;
+	switch (axis) {
+	case 0: return pad->NewState.LeftStickX;
+	case 1: return pad->NewState.LeftStickY;
+	case 2: return pad->NewState.RightStickX;
+	default: return pad->NewState.RightStickY;
+	}
+}
+
+// The Xbox's trigger axis: right trigger minus left trigger, -255..255 (Classic heli yaw and RC
+// Baron roll), from the raw triggers whatever the driving bindings put on them.
+int16
+XboxTriggerX(void)
+{
+	CPad *pad = CPad::GetPad(0);
+	if (pad->ArePlayerControlsDisabled())
+		return 0;
+#ifdef LIBRW_HOST
+	extern bool gRevcTestPadOn;
+	if (gRevcTestPadOn)	// (pad scripts give raw L2/R2 in NewState)
+		return pad->NewState.RightShoulder2 - pad->NewState.LeftShoulder2;
+#endif
+	extern uint8 gPadTriggerAnalog[2];
+	return (int16)gPadTriggerAnalog[1] - (int16)gPadTriggerAnalog[0];
+}
+
+// The pad's buttons as pressed, whatever they are bound to (the Xbox reads some actions from the
+// raw buttons: holster, cutscene skip, look behind in Classic; research), by the PS2-style
