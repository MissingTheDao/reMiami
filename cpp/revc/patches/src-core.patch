+// The options list's "language" row (the EU discs' 8th tab, now a row): left/right cycles the five
+// languages as the Language page does.
+static wchar*
+ConsoleLanguageDraw(bool *disabled, bool userHovering)
+{
+	static const char *names[] = { "FEL_ENG", "FEL_FRE", "FEL_GER", "FEL_ITA", "FEL_SPA" };
+	int l = FrontEndMenuManager.m_PrefsLanguage;
+	return TheText.Get(l >= 0 && l < 5 ? names[l] : "FEL_ENG");
+}
+static void
+ConsoleLanguagePress(int8 action)
+{
+	if (action != FEOPTION_ACTION_LEFT && action != FEOPTION_ACTION_RIGHT && action != FEOPTION_ACTION_SELECT)
+		return;
+	int l = FrontEndMenuManager.m_PrefsLanguage;
+	l = ((l >= 0 && l < 5 ? l : 0) + (action == FEOPTION_ACTION_LEFT ? 4 : 1)) % 5;
+	FrontEndMenuManager.m_PrefsLanguage = l;
+	FrontEndMenuManager.m_bFrontEnd_ReloadObrTxtGxt = true;
+	FrontEndMenuManager.InitialiseChangedLanguageSettings();
+	FrontEndMenuManager.SaveSettings();
+}
+
+// "reset to console defaults": revc's extra settings back to what the console style had (the
+// UI style's visual-style preset: filter, alpha test, draw distance, trails, camera; densities
+// 1.0, cutscene borders on, free cam off, no MP3 boost, dynamic acoustics on, automatic button
+// prompts). The machine's own choices (resolution, vsync, antialiasing) and the language stay.
+static void
+ConsoleDefaultsPress(int8 action)
+{
+	if (action != FEOPTION_ACTION_SELECT)
+		return;
+	if (gUiStyle == 1 || gUiStyle == 2)
+		ApplyVisualStyle(gUiStyle);
+#ifdef PED_CAR_DENSITY_SLIDERS
+	// (the game's own density, 0.6 on every platform; the console styles' caps follow, IniFile.h)
+	PedDensityChange(CIniFile::PedNumberMultiplier, 0.6f);
+	CarDensityChange(CIniFile::CarNumberMultiplier, 0.6f);
+	CIniFile::PedNumberMultiplier = CIniFile::CarNumberMultiplier = 0.6f;
+#endif
+	FrontEndMenuManager.m_PrefsCutsceneBorders = true;
+	TheCamera.bFreeCam = false;
+	FrontEndMenuManager.m_PrefsMP3BoostVolume = 0;
+	DMAudio.SetMP3BoostVolume(0);
+	FrontEndMenuManager.m_PrefsDMA = true;
+	DMAudio.SetDynamicAcousticModelingStatus(true);
+	gButtonPromptsOverride = 0;
+	FrontEndMenuManager.SaveSettings();
+}
+
+// The console options list: section headings (MENUACTION_LABEL) and copies of the PC pages'
+// entries, found by name. section -1: all (PS2 "options" tab); 0 display and look, 1 audio,
+// 2 controls (the Xbox "advanced" sub-tab of Display, Audio, Controls).
+int gConsoleOptionsSection = -1;
+static void
+ConsoleOptionsRows(int section)
+{
+	static const struct { int section; const char *heading; const char *keys[14]; } groups[] = {
+		{ 0, "RVC_OSD", { "FEM_LOD", "FEM_PED", "FEM_CAR", "RVC_VSY", "FED_RES", "FEM_SCF", "RVC_AA", "FEM_ISL", "FEM_2PR", "FEM_CSB", "FEC_FRC" } },
+		{ 0, "RVC_OSL", { "RVC_VST", "RVC_UIS", "RVC_HUA", "FED_CLF" } },
+		{ 1, "RVC_OSA", { "FEA_MPB", "FET_DAM" } },
+		{ 2, "RVC_OSC", { "RVC_PLY", "RVC_GLY", "FEC_JOD", "FEC_RED", "FEC_MOU" } },
+	};
+	// the entries, collected once before the console styles filter the PC pages' rows
+	static CMenuScreenCustom::CMenuEntry pool[4][14];
+	static bool pooled = false;
+	if (!pooled) {
+		pooled = true;
+		for (int g = 0; g < (int)ARRAY_SIZE(groups); g++)
+			for (int k = 0; k < 14 && groups[g].keys[k]; k++) {
+				bool found = false;
+				for (int p = 0; p < MENUPAGES && !found; p++) {
+					if (p == MENUPAGE_CONSOLE_OPTIONS || p == MENUPAGE_CONSOLE_DISPLAY || p == MENUPAGE_CONSOLE_CONTROLS)
+						continue;
+					for (int e = 0; e < NUM_MENUROWS && aScreens[p].m_aEntries[e].m_Action != MENUACTION_NOTHING && !found; e++)
+						if (strncmp(aScreens[p].m_aEntries[e].m_EntryName, groups[g].keys[k], 8) == 0) {
+							pool[g][k] = aScreens[p].m_aEntries[e];
+							pool[g][k].m_X = pool[g][k].m_Y = 0;
+							pool[g][k].m_Align = MENUALIGN_LEFT;
+							found = true;
+						}
+				}
+			}
+	}
+	CMenuScreenCustom &pg = aScreens[MENUPAGE_CONSOLE_OPTIONS];
+	memset(pg.m_aEntries, 0, sizeof(pg.m_aEntries));
+	int n = 0;
+	// the language row (section 0's "game:") and the closing reset row, made here
+	static CCFODynamic languageOption(nil, nil, nil, ConsoleLanguageDraw, ConsoleLanguagePress);
+	static CCFODynamic defaultsOption(nil, nil, nil, nil, ConsoleDefaultsPress);
+	for (int g = 0; g < (int)ARRAY_SIZE(groups); g++) {
+		if (section >= 0 && groups[g].section != section)
+			continue;
+		if (n < NUM_MENUROWS - 1) {
+			pg.m_aEntries[n].m_Action = MENUACTION_LABEL;
+			strncpy(pg.m_aEntries[n].m_EntryName, groups[g].heading, 8);
+			n++;
+		}
+		for (int k = 0; k < 14 && groups[g].keys[k]; k++)
+			if (pool[g][k].m_EntryName[0] && n < NUM_MENUROWS - 1)
+				pg.m_aEntries[n++] = pool[g][k];
+	}
+	if ((section < 0 || section == 0) && n < NUM_MENUROWS - 3) {
+		pg.m_aEntries[n].m_Action = MENUACTION_LABEL;
+		strncpy(pg.m_aEntries[n++].m_EntryName, "RVC_OSG", 8);	// "game:"
+		pg.m_aEntries[n].m_Action = MENUACTION_CFO_DYNAMIC;
+		strncpy(pg.m_aEntries[n].m_EntryName, "RVC_LNG", 8);	// "language"
+		pg.m_aEntries[n].m_CFODynamic = &languageOption;
+		pg.m_aEntries[n++].m_Align = MENUALIGN_LEFT;
+	}
+	if (n < NUM_MENUROWS - 1) {
+		pg.m_aEntries[n].m_Action = MENUACTION_CFO_DYNAMIC;
+		strncpy(pg.m_aEntries[n].m_EntryName, "RVC_RCD", 8);	// "reset to console defaults"
+		pg.m_aEntries[n].m_CFODynamic = &defaultsOption;
+		pg.m_aEntries[n++].m_Align = MENUALIGN_LEFT;
+	}
+}
+
+void
+ConsoleAudioRows(bool)
+{
+	static int optionsApplied = -2;
+	if (optionsApplied != gConsoleOptionsSection) {
+		ConsoleOptionsRows(gConsoleOptionsSection);
+		optionsApplied = gConsoleOptionsSection;
+	}
+	extern int8 gUiStyle;
+	static int audioApplied = -1, displayApplied = -1;
+	static CMenuScreenCustom::CMenuEntry audioSaved[NUM_MENUROWS], displaySaved[NUM_MENUROWS];
+	FilterRows(MENUPAGE_SOUND_SETTINGS, DropAudio, gUiStyle, audioApplied, audioSaved);
+	FilterRows(MENUPAGE_CONSOLE_DISPLAY, DropDisplay, gUiStyle, displayApplied, displaySaved);
+
+	// The Xbox's Load page is "new game / load game" (the PC's New Game page without delete and
+	// back; B goes back).
+	static int newApplied = -1;
+	static CMenuScreenCustom::CMenuEntry newSaved[4];
+	CMenuScreenCustom &ng = aScreens[MENUPAGE_NEW_GAME];
+	if (newApplied != gUiStyle) {
+		if (newApplied < 0)
+			memcpy(newSaved, ng.m_aEntries, sizeof(newSaved));
+		memcpy(ng.m_aEntries, newSaved, sizeof(newSaved));
+		if (gUiStyle == 2) {
+			// new game / load game / quit game, then back (the Xbox skin hides back; "console
+			// discs" is on the main menu, not here; "quit game": the Xbox had none, a PC needs one,
+			// docs/CONSOLE_STYLES.md)
+			CMenuScreenCustom::CMenuEntry back = ng.m_aEntries[3];
+			CMenuScreenCustom::CMenuEntry quit = ng.m_aEntries[1];
+			quit.m_Action = MENUACTION_CHANGEMENU;
+			strncpy(quit.m_EntryName, "FEP_QUI", 8);
+			quit.m_TargetMenu = MENUPAGE_EXIT;
+			memset(&ng.m_aEntries[2], 0, 2 * sizeof(ng.m_aEntries[2]));
+			ng.m_aEntries[2] = quit;
+			ng.m_aEntries[3] = back;
+		}
+		newApplied = gUiStyle;
+	}
+
+	// Load: the PS2 has "load game" / "new game" on the left of its slot list; "new game" takes
+	// the PC's "back" row (triangle goes back).
+	static int loadApplied = -1;
+	static CMenuScreenCustom::CMenuEntry loadSaved, loadSaved9;
+	CMenuScreenCustom &load = aScreens[MENUPAGE_CHOOSE_LOAD_SLOT];
+	if (loadApplied != gUiStyle) {
+		if (loadApplied < 0) {
+			loadSaved = load.m_aEntries[8];
+			loadSaved9 = load.m_aEntries[9];
+		}
+		load.m_aEntries[8] = loadSaved;
+		load.m_aEntries[9] = loadSaved9;
+		// ("console discs" is on the main menu, not on the PS2 Load page; its place takes "quit
+		// game": the consoles had none, a PC needs one, under "new game" as the PC's pause menu
+		// has it; docs/CONSOLE_STYLES.md)
