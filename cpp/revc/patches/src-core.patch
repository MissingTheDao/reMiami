+void
+UiStyleAfterChange(int8 before, int8 after)
+{
+	if (UiStyleAvailable(after)) {
+		MapStyleRestartNote();
+		return;
+	}
+	// on past the console styles without a disc, the way the option was moving
+	const int n = ARRAY_SIZE(uiStyleOpts);
+	const int step = after == (before + 1) % n ? 1 : n - 1;
+	int ui = after;
+	while (!UiStyleAvailable(ui))
+		ui = (ui + step) % n;
+	gUiStyle = ui;
+	if (uiStyleSelect)
+		uiStyleSelect->displayedValue = uiStyleSelect->lastSavedValue = ui;
+	FrontEndMenuManager.SaveSettings();
+	MapStyleRestartNote();
+}
