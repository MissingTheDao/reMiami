+// 13-16 D-pad up/right/down/left. Sampled once per pad update.
+static bool rawNow[16], rawBefore[16];
+static void
+SampleRawButtons(const CControllerState &s)
+{
+	memcpy(rawBefore, rawNow, sizeof(rawNow));
+#ifdef LIBRW_HOST
+	extern bool gRevcTestPadOn;
+	if (gRevcTestPadOn) {	// (pad scripts set the PS2-style state directly)
+		const int16 v[16] = { s.Circle, s.Cross, s.Square, s.Triangle, s.LeftShoulder2, s.RightShoulder2, s.LeftShoulder1,
+			s.RightShoulder1, s.Select, s.LeftShock, s.RightShock, s.Start, s.DPadUp, s.DPadRight, s.DPadDown, s.DPadLeft };
+		for (int i = 0; i < 16; i++)
+			rawNow[i] = v[i] != 0;
+		return;
+	}
+#endif
+	for (int i = 0; i < 16; i++)
+		rawNow[i] = ControlsManager.m_aButtonStates[i];
