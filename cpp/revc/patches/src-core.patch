+// revc: the first-person look rate (deg/s) in the console styles for a look value from
+// CPad::LookAroundLeftRight/UpDown ((|axis| - 85) * 127/32), by the stick's tilt (|axis|/127):
+// piecewise linear through the consoles' measurements at the default FOV.
+//  - PS2 v1.40 yaw: nothing to 0.88, 38 at 0.90, 136 at 0.95, 220 full; pitch 150 full.
+//  - Xbox yaw, by the camera's pitch (a targeted run at five pitches, research
+//    autopad-runs/xbox_cam_partial_curve.csv; the same at a pitch 10 s apart, so the camera
+//    state, not time): level or up nothing to 0.80, 57 at 0.85, 79 at 0.90, 108 at 0.95, 144
+//    full; looking down (below about -10 degrees, uncertain by ~10: measured at 0, +60, ~-20,
+//    -89.5) 67 at 0.75, 78 at 0.80, 94, 111, 127, 145 full (below 0.75 extended linearly to the
+//    dead zone, 85/128, unmeasured). Pitch 83 full, the same curve scaled.
+static float
+ConsoleLookRate(float look, bool pitch, bool lookingDown)
+{
+	static const float ps2[][2] = { { 0.88f, 0.0f }, { 0.90f, 38.0f }, { 0.95f, 136.0f }, { 1.0f, 220.0f } };
+	static const float xboxLevel[][2] = { { 0.80f, 0.0f }, { 0.85f, 57.0f }, { 0.90f, 79.0f }, { 0.95f, 108.0f }, { 1.0f, 144.0f } };
+	static const float xboxDown[][2] = { { 85.0f/127.0f, 48.0f }, { 0.75f, 67.0f }, { 0.80f, 78.0f }, { 0.85f, 94.0f }, { 0.90f, 111.0f }, { 0.95f, 127.0f }, { 1.0f, 145.0f } };
+	bool isPs2 = gUiStyle == 1;
+	const float (*t)[2] = isPs2 ? ps2 : lookingDown ? xboxDown : xboxLevel;
+	int n = isPs2 ? 4 : lookingDown ? 7 : 5;
+	float tilt = Min(1.0f, (85.0f + Abs(look) * 32.0f / 127.0f) / 127.0f);
+	float rate = 0.0f;
+	if(look == 0.0f || tilt < t[0][0])
+		return 0.0f;
+	if(tilt >= t[n-1][0])
+		rate = t[n-1][1];
+	else
+		for(int i = 1; i < n; i++)
+			if(tilt <= t[i][0]){
+				rate = t[i-1][1] + (t[i][1] - t[i-1][1]) * (tilt - t[i-1][0]) / (t[i][0] - t[i-1][0]);
