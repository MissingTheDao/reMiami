+
+// revc (plan task 13): rows a console's page doesn't have are taken out while that UI style is
+// shown and put back for the PC style: on the Audio page the PC's MP3 volume boost, dynamic
+// acoustics, restore defaults and back (the consoles show music, sfx, radio station); on the
+// console Display page the wide screen row in the Xbox style (only the PS2 had it).
+static void
+FilterRows(int page, bool (*drop)(int action, int style), int style, int &applied, CMenuScreenCustom::CMenuEntry *saved)
+{
+	CMenuScreenCustom &pg = aScreens[page];
+	if (applied == style)
+		return;
+	if (applied < 0)
+		memcpy(saved, pg.m_aEntries, sizeof(pg.m_aEntries));
+	else
+		memcpy(pg.m_aEntries, saved, sizeof(pg.m_aEntries));
+	int n = 0;
+	for (int i = 0; i < NUM_MENUROWS; i++)
+		if (!drop(saved[i].m_Action, style))
+			pg.m_aEntries[n++] = saved[i];
+	for (; n < NUM_MENUROWS; n++)
+		memset(&pg.m_aEntries[n], 0, sizeof(pg.m_aEntries[n]));
+	applied = style;
+}
+
+static bool
+DropAudio(int a, int style)
+{
+	return style != 0 && (a == MENUACTION_MP3VOLUMEBOOST || a == MENUACTION_DYNAMICACOUSTIC || a == MENUACTION_RESTOREDEF || a == MENUACTION_GOBACK);
+}
+
+static bool
+DropDisplay(int a, int style)
+{
+	return style == 2 && (a == MENUACTION_WIDESCREEN || a == MENUACTION_CFO_DYNAMIC);	// (and the PS2's screen position)
+}
