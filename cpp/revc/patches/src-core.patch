+// revc: the PS2 page change's alphas for this frame (Ps2AccumBegin, before anything is drawn)
+static void
+Ps2PageFade(CMenuManager *m)
+{
+	// the console's own steps over the uncleared picture (PS2 v1.40, research): the fade value f
+	// +50 per 30 Hz menu update; old content 305 - f (from 255), camo f, new content f + 50.
+	// Counted in menu updates from the first one that starts at or after the switch (the console
+	// reads the pad once per update, so its first step always lasts a whole update)
+	extern int Ps2AccumUpdates(void);
+	int u = Ps2AccumUpdates();
+	if (u < 0) {	// (a switch in the middle of an update: the old picture until the next one)
+		m->m_nMenuFadeAlpha = 1;
+		ps2OldAlpha = 255;
+		ps2CamoAlpha = 0;
+		return;
+	}
+	int f = Min(255, 50 * u);
+	m->m_nMenuFadeAlpha = f >= 255 ? 255 : Min(254, f + 50);	// (still fading until the camo is full)
+	ps2OldAlpha = Min(255, 305 - f);
+	ps2CamoAlpha = f;
+}
+
+// revc: the PS2 menu never clears its picture: a page change draws its translucent layers over the
+// last frame, so the old page lingers and the new one builds up (PS2 v1.40, research). Emulated:
+// the menu's finished picture is kept (Ps2AccumCapture, after
+// the text) and, while such a change runs, drawn first; each 30 Hz menu update starts from the
+// picture of the update before, so the result doesn't depend on the frame rate. Page changes and the
+// confirmations alike.
+static RwRaster *ps2Img[3];
+static RwTexture *ps2ImgTex[3];
+static uint32 ps2ImgTick[3] = { ~0u, ~0u, ~0u };	// the menu update each picture was finished in
+static int ps2ImgBase = -1;	// the picture this update draws over
+static uint32 ps2AccumTick = ~0u;
+// the console swaps two picture buffers per update, so an update draws over the picture of the
+// update before last (PS2 v1.40, research)
+#define PS2_ACCUM_LAG 2
+static bool ps2AccumWas;
+static uint32 ps2AccumStartTick, ps2LastFrameMs;
+// The menu's 30 Hz update number for a pause-mode time (the clock moves 33.3 ms per update: whole
+// 33 ms buckets drifted, so now and then two updates fell into one bucket or one into two)
+static uint32 Ps2UpdateTick(uint32 ms) { return (ms * 3 + 50) / 100; }
+
+// Menu updates since the accumulating page change's first full one.
+int
+Ps2AccumUpdates(void)
+{
+	return (int)(Ps2UpdateTick(CTimer::GetTimeInMillisecondsPauseMode()) - ps2AccumStartTick);
+}
+
+bool
+CMenuManager::Ps2AccumActive(void)
+{
+	return m_nMenuFadeAlpha < 255 && MenuSkinPS2Active(m_nCurrScreen, m_bGameNotLoaded) && gPs2FadeIsPageChange &&
+		m_firstStartCounter == 255;
+}
+
+void
+CMenuManager::Ps2AccumBegin(void)
+{
+	uint32 now = CTimer::GetTimeInMillisecondsPauseMode();
+	bool updateStart = now != ps2LastFrameMs;	// (the first frame drawn of a 30 Hz menu update)
+	ps2LastFrameMs = now;
+	if (!Ps2AccumActive()) {
+		ps2AccumWas = false;
+		return;
+	}
+	uint32 tick = Ps2UpdateTick(now);
+	if (!ps2AccumWas)
+		ps2AccumStartTick = updateStart ? tick : tick + 1;
+	if (!ps2AccumWas || tick != ps2AccumTick) {
+		// this update's base: the picture of PS2_ACCUM_LAG updates ago, else the latest before it
+		ps2ImgBase = -1;
+		for (int j = 0; j < 3; j++)
+			if (ps2ImgTick[j] != ~0u && ps2ImgTick[j] < tick && ps2ImgTick[j] + PS2_ACCUM_LAG >= tick &&
+			    (ps2ImgBase < 0 || ps2ImgTick[j] < ps2ImgTick[ps2ImgBase]))
+				ps2ImgBase = j;
+		if (ps2ImgBase < 0)
+			for (int j = 0; j < 3; j++)
+				if (ps2ImgTick[j] != ~0u && ps2ImgTick[j] < tick && (ps2ImgBase < 0 || ps2ImgTick[j] > ps2ImgTick[ps2ImgBase]))
+					ps2ImgBase = j;
+	}
+	ps2AccumTick = tick;
+	ps2AccumWas = true;
+	if (m_nMenuFadeAlpha == 0)	// (the switch's frame: the new panel is still to be set up, below)
+		ps2PanelSetupPending = true;
+	Ps2PageFade(this);
+	if (ps2ImgBase >= 0) {
+		CSprite2d spr;
+		spr.m_pTexture = ps2ImgTex[ps2ImgBase];
+		spr.Draw(CRect(0.0f, 0.0f, SCREEN_WIDTH, SCREEN_HEIGHT), CRGBA(255, 255, 255, 255));
+		spr.m_pTexture = nil;
+		SetFrontEndRenderStates();
+	}
+}
+
+// After the menu's text is drawn (main.cpp): keep the picture for the next PS2 page change.
+void
+Ps2AccumCapture(void)
+{
+	if (!MenuSkinPS2Active(FrontEndMenuManager.m_nCurrScreen, FrontEndMenuManager.m_bGameNotLoaded))
+		return;
+	RwRaster *cam = RwCameraGetRaster(Scene.camera);
+	uint32 tick = Ps2UpdateTick(CTimer::GetTimeInMillisecondsPauseMode());
+	int w = RwRasterGetWidth(cam), h = RwRasterGetHeight(cam), i = tick % 3;	// (one picture per update, the last three kept)
+	for (int j = 0; j < 3; j++)
+		if (ps2Img[j] && (RwRasterGetWidth(ps2Img[j]) != w || RwRasterGetHeight(ps2Img[j]) != h)) {
+			RwTextureDestroy(ps2ImgTex[j]);	// (destroys its raster too)
+			ps2Img[j] = nil;
+			ps2ImgTex[j] = nil;
+			ps2ImgTick[j] = ~0u;
+		}
+	if (!ps2Img[i]) {
+		ps2Img[i] = RwRasterCreate(w, h, RwRasterGetDepth(cam), rwRASTERTYPECAMERATEXTURE);
+		ps2ImgTex[i] = RwTextureCreate(ps2Img[i]);
+		RwTextureSetFilterMode(ps2ImgTex[i], rwFILTERNEAREST);
+	}
+	RwRasterPushContext(ps2Img[i]);
+	RwRasterRenderFast(cam, 0, 0);
+	RwRasterPopContext();
+	ps2ImgTick[i] = tick;
+}
+
+// revc: the PS2 menu's opening fade for this frame: after the black hold, the content's alpha +50
+// per 30 Hz menu update (PS2 v1.40, research). Set where the frame starts drawing (DrawBackground)
+// so every part of the frame uses the same step, and again in UpdateFade.
+void
+CMenuManager::Ps2OpenFade(void)
+{
+	uint32 el = CTimer::GetTimeInMillisecondsPauseMode() - gPs2MenuOpenedAt;
+	int f = el < 500 ? 0 : Min(255, 50 * (int)((el - 500) / 33 + 1));
+	m_nMenuFadeAlpha = Max(1, f);	// (0 would end the fade at once)
+	m_firstStartCounter = f >= 255 ? 255 : -50 + f * 305 / 255;
+}
+
+// revc: the PS2 menu's opening: the camo, logo, help box and tab bar fade in one +50 step behind
+// the page's content (its opening counter starts at -50; PS2 v1.40, research). `a`: the content's
+// alpha.
+int
+CMenuManager::Ps2OpeningBehind(int a)
+{
+	if (MenuSkinPS2Active(m_nCurrScreen, m_bGameNotLoaded) && !gPs2FadeIsPageChange && m_firstStartCounter < 255)
+		return Max(0, a - 50);
+	return a;
+}
