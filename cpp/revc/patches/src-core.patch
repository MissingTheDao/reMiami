+// Menu entries whose value left/right changes (sliders, toggles, selectors); the rest open a
+// page or do something when confirmed.
+static bool
+MenuActionAdjustable(int action)
+{
+	switch (action) {
+	case MENUACTION_CFO_SLIDER: case MENUACTION_CFO_SELECT: case MENUACTION_CFO_DYNAMIC:
+	case MENUACTION_INVERTPADY: case MENUACTION_CTRLDISPLAY: case MENUACTION_FRAMESYNC:
+	case MENUACTION_FRAMELIMIT: case MENUACTION_TRAILS: case MENUACTION_SUBTITLES:
+	case MENUACTION_WIDESCREEN: case MENUACTION_BRIGHTNESS: case MENUACTION_MUSICVOLUME:
+	case MENUACTION_SFXVOLUME: case MENUACTION_RADIO: case MENUACTION_LEGENDS:
+	case MENUACTION_RADARMODE: case MENUACTION_HUD: case MENUACTION_SHOWHEADBOB:
+	case MENUACTION_INVVERT: case MENUACTION_SCREENRES: case MENUACTION_AUDIOHW:
+	case MENUACTION_SPEAKERCONF: case MENUACTION_CTRLMETHOD: case MENUACTION_DYNAMICACOUSTIC:
+	case MENUACTION_MOUSESTEER: case MENUACTION_DRAWDIST: case MENUACTION_MOUSESENS:
+	case MENUACTION_MP3VOLUMEBOOST:
+#ifdef GAMEPAD_MENU
+	case MENUACTION_CTRLVIBRATION: case MENUACTION_CTRLCONFIG:
+#endif
+		return true;
+	}
+	return false;
+}
+
+// The menu's helper line ("LEFT, RIGHT, MOUSEWHEEL TO ADJUST", "APPLY") with the pad's button
+// glyphs instead while a controller is the input in use (font tokens: ~<~ ~>~ stick left/right,
+// ~X~ the bottom face button); keyboard and mouse keep the game's text.
+static wchar*
+HelperString(const char *key)
+{
+#ifdef LIBRW_HOST
+	if (hostActiveInputKind() != 0) {
+		static wchar buf[64];
+		const char *pad = nil;
+		if (strcmp(key, "FET_MIG") == 0)
+			pad = "~<~ ~>~ ADJUST";
+		else if (strcmp(key, "FET_APP") == 0)
+			pad = "~X~ APPLY";
+		else if (strcmp(key, "FET_CIG") == 0)
+			pad = "~X~ CHANGE, THEN PRESS THE NEW BUTTON";
+		if (pad) {
+			AsciiToUnicode(pad, buf);
+			return buf;
+		}
+	}
+#endif
+	return TheText.Get(key);
+}
