+static void
+ApplyVisualStyle(int i)
+{
+	const VisualStyle &s = visualStyles[i];
+	CPostFX::EffectSwitch = s.filter;
+	if (s.lod > 0.0f)
+		FrontEndMenuManager.m_PrefsLOD = CRenderer::ms_lodDistScale = s.lod;
+	if (s.ui >= 0)
+		gUiStyle = s.ui;
+	CPostFX::MotionBlurOn = s.trails;
+	gScreenDroplets = s.droplets;
+	gXboxTrails = s.xboxTrails;
+	if (s.control >= 0) {
+		FrontEndMenuManager.m_ControlMethod = s.control;
+		CCamera::m_bUseMouse3rdPerson = s.control == CONTROL_STANDARD;
+	}
+#ifdef PS2_ALPHA_TEST
+	gPS2alphaTest = s.alphaTest;
+#endif
+#ifdef EXTENDED_PIPELINES
+	if (NeoAvailable()) {
+		CustomPipes::VehiclePipeSwitch = s.neo ? CustomPipes::VEHICLEPIPE_NEO : CustomPipes::VEHICLEPIPE_MATFX;
+		CustomPipes::RimlightEnable = s.neo;
+		CustomPipes::LightmapEnable = s.neo;
+		CustomPipes::GlossEnable = s.neo;
+	}
+#endif
+}
