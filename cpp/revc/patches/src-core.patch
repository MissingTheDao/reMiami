+// revc: in a console UI style the menu shows the console skin's own pages; the PC menu's pages are
+// reached only for the deliberate exceptions below (docs/CONSOLE_STYLES.md, "Console menus: PC pages").
+// Any other switch to a PC page goes back to the last page the skin drew.
+static int consoleLastPage = -1, consoleLastOption = 0;
+
+static bool
+ConsoleSkinDraws(int page)
+{
+	if (gUiStyle == 1)
+		return MenuSkinPS2Active(page, false);
+	if (gUiStyle == 2)
+		return MenuSkinXboxActive(page, false) || MenuSkinXboxSave(page, false);
+	return false;
+}
+
+bool
+MenuConsolePcPage(int page)
+{
+	// the PC's input setup, which the consoles had no counterpart for (reached on purpose from the
+	// console options' controls section)
+	if (page == MENUPAGE_KEYBOARD_CONTROLS || page == MENUPAGE_MOUSE_CONTROLS)
+		return true;
+#ifdef DETECT_JOYSTICK_MENU
+	if (page == MENUPAGE_DETECT_JOYSTICK)
+		return true;
+#endif
+	// transient and warning screens of the PC's save and load code
+	if (page == MENUPAGE_LOADING_IN_PROGRESS || page == MENUPAGE_SAVE_CHEAT_WARNING ||
+	    page == MENUPAGE_SAVE_CUSTOM_WARNING || page == MENUPAGE_SAVE_SUCCESSFUL)
+		return true;
+	// the PC-only mission retry prompt, and the quit screen after "quit game"
+	return page == MENUPAGE_MISSION_RETRY || page == MENUPAGE_OUTRO;
+}
