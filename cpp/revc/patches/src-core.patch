+// revc (plan task 13): the console UI styles lay the HUD out as on the console's 4:3 screen,
+// scaled by the screen height and centred (pillarboxed) on wider screens: the HUD code sees a 4:3
+// screen and the device moves its 2D draws to the centre.
+extern int8 gUiStyle;
+// Graphics menu HUD AREA ([Graphics] HudArea): 0 corners (the console layout anchored to the
+// screen's edges, default; user 2026-11-11), 1 the 4:3 area centred as on the console.
+int8 gConsoleHudArea = 0;
+extern "C" void revc_device_set_im2d_offset(float dx, float dy);
+static int32 consoleHudSavedWidth;
+static float consoleHudSavedAspect;
+
+static void
+ConsoleHudBegin(void)
+{
+	float w43 = Floor(SCREEN_HEIGHT * 4.0f / 3.0f);
+	// the PS2 style's screen position (Display page) moves the HUD, for TVs that crop the picture
+	extern float ScreenPositionX(void), ScreenPositionY(void);
+	float px = gUiStyle == 1 ? Floor(SCREEN_SCALE_X(ScreenPositionX())) : 0.0f, py = gUiStyle == 1 ? Floor(SCREEN_SCALE_Y(ScreenPositionY())) : 0.0f;
+	// HUD area: 0 corners (on screens wider than 16:9, of a centred 16:9 box: no console went
+	// wider; HIRES_PRESENTATION 4b), 1 the console's 4:3, 2 the screen's edges
+	float w169 = Floor(SCREEN_HEIGHT * 16.0f / 9.0f);
+	if (gUiStyle != 0 && gConsoleHudArea == 0 && w169 < SCREEN_WIDTH)
+		w43 = w169;
+	bool area = !(gUiStyle == 0 || gConsoleHudArea == 2 || w43 >= SCREEN_WIDTH);
+	if (!area && px == 0.0f && py == 0.0f)
+		return;
+	CFont::DrawFonts();	// text queued before (pickup texts) is placed on the whole screen
+	consoleHudSavedWidth = RsGlobal.width;
+	consoleHudSavedAspect = CDraw::GetAspectRatio();
+	if (area) {
+		revc_device_set_im2d_offset(Floor((RsGlobal.width - w43) / 2.0f) + px, py);
+		RsGlobal.width = (int32)w43;
+		CDraw::SetAspectRatio(w43 / SCREEN_HEIGHT);
+	} else
+		revc_device_set_im2d_offset(px, py);
+}
+
+static void
+ConsoleHudEnd(void)
+{
+	if (consoleHudSavedWidth == 0)
+		return;
+	RsGlobal.width = consoleHudSavedWidth;
+	CDraw::SetAspectRatio(consoleHudSavedAspect);
+	revc_device_set_im2d_offset(0.0f, 0.0f);
+	consoleHudSavedWidth = 0;
+}
