 static void _psInitializeVibration() {}
-static void _psHandleVibration() {}
+
+// Pad vibration through SDL (the original only had XInput on Windows; CPad::AffectFromXinput). Same
+// behaviour: both motors at ShakeFreq/255 while ShakeDur (ms) runs down by the game's time step.
+// Called once per pad capture; each request lasts a little longer than a 30 Hz step and is
+// renewed until the shake ends, so a stalled game never leaves a pad buzzing.
+static void _psHandleVibration(RwInt32 padID, int hostPad)
+{
+	static uint8 lastFreq[2];
+	if (padID < 0 || padID > 1)
+		return;
+	CPad *pad = CPad::GetPad(padID);
+	uint8 freq = pad->ShakeFreq;
+	int32 step = CTimer::GetTimeStepInMilliseconds();
+	if (pad->ShakeDur < step)
+		pad->ShakeDur = 0;
+	else
+		pad->ShakeDur -= step;
+	if (pad->ShakeDur == 0)
+		pad->ShakeFreq = 0;
+
+	if (freq != 0) {
+		// revc: the Xbox version's motor mapping: heavy (low-frequency) motor freq * 64 (at most
+		// ~25 %), light motor freq * 256 (up to full strength).
+		// The PS2: the large motor alone, at the shake's strength (PS2 v1.40, research).
+		extern int8 gUiStyle;
+		if (gUiStyle == 1)
+			hostGamepadRumble(hostPad, (uint16)(freq * 257), 0, 200);
+		else
+		hostGamepadRumble(hostPad, (uint16)(freq * 64), (uint16)(freq * 256), 200);
+	} else if (lastFreq[padID] != 0) {
+		hostGamepadRumble(hostPad, 0, 0, 0);
+	}
+	lastFreq[padID] = freq;
+}
 
