+// The flame frames default to the PC's single flame (at start); the Xbox's are loaded the first
+// time the Xbox style is active (ApplyStyle), so no other style reads the Xbox import.
+static bool gXboxFlameFramesTried;
+
+static void InitFlameFrames(void) {
+	for (int32 i = 0; i < REVC_FLAME_FRAMES; i++)
+		gpFlameFrames[i] = gpFlame1Raster;
+	gFlameFramesFound = 0;
+	gXboxFlameFramesTried = false;
+}
+
+static void LoadXboxFlameFrames(void) {
+	int32 i;
+	gXboxFlameFramesTried = true;
+
+	const char *path = revc_particle_xbox_txd_path();
+	if (path == nil) return;
+
+	int32 slot = CTxdStore::FindTxdSlot("particlexbox");
+	if (slot == -1) slot = CTxdStore::AddTxdSlot("particlexbox");
+
+	if (CTxdStore::GetSlot(slot)->texDict == nil) {
+		if (!CTxdStore::LoadTxd(slot, path)) return;
+		CTxdStore::AddRef(slot);
+	}
+
+	CTxdStore::PushCurrentTxd();
+	CTxdStore::SetCurrentTxd(slot);
+
+	char buf[16];
+	for (i = 0; i < REVC_FLAME_FRAMES; i++) {
+		sprintf(buf, "flame%02d", i + 1);
+		RwTexture *tex = RwTextureRead(buf, nil);
+		if (tex) {
+			gpFlameFrames[i] = RwTextureGetRaster(tex);
+			gFlameFramesFound++;
+		}
+	}
+
+	CTxdStore::PopCurrentTxd();
+	debug("CParticle: %d Xbox flame frames\n", gFlameFramesFound);
+}
